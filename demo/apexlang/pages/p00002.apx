page 2 (
    name: Projects
    title: Projects
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
        warnOnUnsavedChanges: false
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region breadcrumbs (
        name: Breadcrumbs
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region projects (
        name: Projects
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select 
                "ID",
                "NAME_JTL",
                "LANG",
                "NAME",
                "DESCRIPTION",
                "ALIAS",
                "ACTIVE_IND",
                "CREATED_BY",
                "CREATED_ON",
                "UPDATED_BY",
                "UPDATED_ON"
                 from px_projects2_vl
                
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        link {
            linkColumn: customTarget
            target: {
                page: 3
                items: {
                    P3_ID: #ID#
                }
            }
            linkIcon: &EDIT_BUTTON.
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        actionsMenu {
            subscription: false
        }
        advanced {
            savedReportMappingIdentifier: 7877516194085257
        }

        column ACTIVE_IND (
            type: plainText
            heading {
                heading: Active?
                alignment: center
            }
            layout {
                sequence: 4
                columnAlignment: center
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: D
            }
            help {
                helpText: Indicates if the record is active or inactive.
            }
        )

        column ALIAS (
            type: plainText
            heading {
                heading: Alias
            }
            layout {
                sequence: 3
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: C
            }
            help {
                helpText: No help available for this page item.
            }
        )

        column CREATED_BY (
            type: plainText
            heading {
                heading: Created By
                alignment: center
            }
            layout {
                sequence: 5
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: E
            }
            help {
                helpText: No help available for this page item.
            }
        )

        column CREATED_ON (
            type: plainText
            heading {
                heading: Created On
                alignment: center
            }
            layout {
                sequence: 6
                columnAlignment: end
            }
            source {
                dataType: DATE
            }
            advanced {
                endUserAlias: F
            }
            help {
                helpText: No help available for this page item.
            }
        )

        column DESCRIPTION (
            type: plainText
            heading {
                heading: Description
                alignment: center
            }
            layout {
                sequence: 38
            }
            columnFormatting {
                htmlExpression: <pre>#DESCRIPTION#</pre>
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: M
            }
        )

        column ID (
            type: plainText
            heading {
                heading: Id
                alignment: center
            }
            layout {
                sequence: 1
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: A
            }
            help {
                helpText: No help available for this page item.
            }
        )

        column LANG (
            type: plainText
            heading {
                heading: Lang
                alignment: center
            }
            layout {
                sequence: 28
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: L
            }
        )

        column NAME (
            type: plainText
            heading {
                heading: Name
                alignment: center
            }
            layout {
                sequence: 18
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: K
            }
        )

        column NAME_JTL (
            type: plainText
            heading {
                heading: Name Jtl
                alignment: center
            }
            layout {
                sequence: 2
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: B
            }
            help {
                helpText: No help available for this page item.
            }
        )

        column UPDATED_BY (
            type: plainText
            heading {
                heading: Updated By
                alignment: center
            }
            layout {
                sequence: 7
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: G
            }
            help {
                helpText: No help available for this page item.
            }
        )

        column UPDATED_ON (
            type: plainText
            heading {
                heading: Updated On
                alignment: center
            }
            layout {
                sequence: 8
                columnAlignment: end
            }
            source {
                dataType: DATE
            }
            advanced {
                endUserAlias: H
            }
            help {
                helpText: No help available for this page item.
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }

        savedReport 79002 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn ACTIVE_IND (
                sequence: 5
            )

            displayColumn ALIAS (
                sequence: 4
            )

            displayColumn DESCRIPTION (
                sequence: 2
            )

            displayColumn LANG (
                sequence: 3
            )

            displayColumn NAME (
                sequence: 1
            )

        )

    )

    button create (
        buttonName: CREATE
        label: Add New
        layout {
            sequence: 10
            region: @projects
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconRight
            ]
            icon: fa-plus
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 3
                clearCache: 3
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

)

