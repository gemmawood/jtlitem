page 4 (
    name: JTL with Blob
    title: JTL with CLOB
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
        warnOnUnsavedChanges: false
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region jtl-with-clob (
        name: JTL with CLOB
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select id
                     , name
                     , decode(sign(length(description)-150)
                       , null, null
                       , -1, description
                       , substr(description,1,150) ||'…') description
                     , active_ind
                     , created_by
                     , created_on
                     , updated_by
                     , updated_on
                from px_jtl_with_clob_vl
                  
                
                
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        link {
            linkColumn: customTarget
            target: {
                page: 5
                items: {
                    P5_ID: #ID#
                }
            }
            linkIcon: &EDIT_BUTTON.
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        actionsMenu {
            subscription: false
        }
        advanced {
            savedReportMappingIdentifier: 443878911454084626
        }

        column ACTIVE_IND (
            type: plainText
            heading {
                heading: Active?
                alignment: center
            }
            layout {
                sequence: 31
                columnAlignment: center
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: D
            }
            help {
                helpText: Indicates is the record is enabled.
            }
        )

        column CREATED_BY (
            type: plainText
            heading {
                heading: Created By
                alignment: center
            }
            layout {
                sequence: 41
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: E
            }
        )

        column CREATED_ON (
            type: plainText
            heading {
                heading: Created On
                alignment: center
            }
            layout {
                sequence: 51
            }
            source {
                dataType: DATE
            }
            advanced {
                endUserAlias: F
            }
        )

        column DESCRIPTION (
            type: plainText
            heading {
                heading: Description
                alignment: center
            }
            layout {
                sequence: 21
            }
            columnFormatting {
                htmlExpression: <pre>#DESCRIPTION#</pre>
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: J
            }
        )

        column ID (
            type: plainText
            heading {
                heading: Id
                alignment: center
            }
            layout {
                sequence: 1
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: A
            }
        )

        column NAME (
            type: plainText
            heading {
                heading: Name
                alignment: center
            }
            layout {
                sequence: 11
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: I
            }
        )

        column UPDATED_BY (
            type: plainText
            heading {
                heading: Updated By
                alignment: center
            }
            layout {
                sequence: 61
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: G
            }
        )

        column UPDATED_ON (
            type: plainText
            heading {
                heading: Updated On
                alignment: center
            }
            layout {
                sequence: 71
            }
            source {
                dataType: DATE
            }
            advanced {
                endUserAlias: H
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }

        savedReport 4438947 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn ACTIVE_IND (
                sequence: 3
            )

            displayColumn CREATED_BY (
                sequence: 4
            )

            displayColumn CREATED_ON (
                sequence: 5
            )

            displayColumn DESCRIPTION (
                sequence: 2
            )

            displayColumn NAME (
                sequence: 1
            )

            displayColumn UPDATED_BY (
                sequence: 6
            )

            displayColumn UPDATED_ON (
                sequence: 7
            )

        )

    )

    button create (
        buttonName: CREATE
        label: Add New
        layout {
            sequence: 30
            region: @jtl-with-clob
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconRight
            ]
            icon: fa-plus
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 5
                clearCache: 5
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

)

